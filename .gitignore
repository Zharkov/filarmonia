# Виртуальное окружение Python
venv/
.venv/

# Кэш Python и инструментов
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# База данных: рабочая база с содержимым сайта в репозиторий не попадает
*.db
*.db.bak*
*.sqlite
*.sqlite3
*.db-journal

# Загруженные через панель администратора фото, видео и документы — они живут на сервере
# и в резервных копиях, а не в коде. Папка в репозитории остаётся пустой.
filarmonia/static/uploads/*
!filarmonia/static/uploads/.gitkeep

# Настройки окружения: ключи, пароли, адрес базы (образец — .env.example)
.env
.env.*
!.env.example

# Журналы
*.log

# Резервные и временные файлы
*.bak
*.tmp
*.swp
~$*

# Редакторы
.idea/
.vscode/

# Служебные файлы систем и Яндекс.Диска
.DS_Store
Thumbs.db
desktop.ini
.sync/

# Локальные настройки Claude Code
.claude/settings.local.json
.claude/settings.local.json.bak
