SECRET_KEY=замените-на-случайную-строку
DATABASE_URL=sqlite:///filarmonia.db
# DATABASE_URL=postgresql+psycopg://filarmonia:пароль@localhost/filarmonia
UPLOAD_FOLDER=
SESSION_COOKIE_SECURE=0
# приложение за nginx или другим обратным прокси
TRUST_PROXY=0
# 1 — закрыть сайт от поисковиков (для тестовых копий)
SITE_NOINDEX=0
# логин и пароль на весь тестовый стенд (работает только с SITE_NOINDEX=1, basic-auth).
# Без них стенд открыт всем, а приём обращений и анкет на нём отключён.
STAND_USER=
STAND_PASSWORD=
# пароль администратора при создании базы; пусто — возьмётся из seed.py
ADMIN_PASSWORD=

# до скольких пикселей ужимать загруженные фотографии и с каким качеством
IMAGE_MAX_SIDE=2000
IMAGE_QUALITY=85

# защита входа в панель администратора от подбора пароля
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# пауза между обращениями граждан с одного адреса, секунды
APPEAL_INTERVAL_SECONDS=60

# адрес сайта для канонических ссылок, карты сайта и микроразметки, например https://smolensk-filarmonia.ru.
# Обязательно на боевом: с SESSION_COOKIE_SECURE=1 или TRUST_PROXY=1 сайт без него не запускается.
# На Render, если пусто, берётся RENDER_EXTERNAL_URL.
SITE_URL=
# сеанс сотрудника: не дольше стольких часов и до стольких минут без действий
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60
# 0 — не сжимать ответы в приложении, если это делает nginx
COMPRESS_RESPONSES=1
# файл журнала с ротацией; пусто — журнал в поток ошибок
LOG_FILE=

# пауза между отправками одной анкеты «Независимой оценки» с одного адреса, секунды
SURVEY_INTERVAL_SECONDS=15

# исходящая почта: на неё уходят заполненные анкеты (получатель — настройка «survey_email» в панели).
# Пустой MAIL_SERVER — письма не отправляются, ответы только сохраняются в базе.
# Яндекс 360: smtp.yandex.ru, порт 465 (SSL); Mail.ru: smtp.mail.ru, порт 465.
# В MAIL_PASSWORD нужен пароль приложения (создаётся в настройках безопасности почты), а не пароль входа.
MAIL_SERVER=
MAIL_PORT=465
# 1 — соединение сразу по SSL (порт 465); для STARTTLS (порт 587) поставьте MAIL_USE_SSL=0 и MAIL_USE_TLS=1
MAIL_USE_SSL=1
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
# адрес отправителя; пусто — берётся MAIL_USERNAME (почтовики требуют, чтобы они совпадали)
MAIL_FROM=
MAIL_TIMEOUT=5
# 1 — отправлять письма в фоновом потоке (посетитель не ждёт почтовый сервер)
MAIL_ASYNC=1
